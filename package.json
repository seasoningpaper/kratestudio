{
  "name": "koi-maker",
  "version": "0.41.0-r4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node portal/build.mjs && node scripts/validate-worker.mjs",
    "test": "node scripts/test-local.mjs",
    "predev": "npm run build",
    "dev": "node scripts/serve-local.mjs",
    "start": "node scripts/serve-local.mjs",
    "test:local": "node scripts/test-local.mjs",
    "test:all": "node scripts/test-local.mjs --all",
    "check:assets": "node scripts/verify-static-assets.mjs",
    "test:softflow": "node --test --test-concurrency=1 --test-timeout=30000 tests/0410-r3-gui.test.mjs tests/0410-r3-integration.test.mjs",
    "build:editor-r4": "node scripts/generate-feature-matrix.mjs && node scripts/generate-script-guide.mjs && node scripts/generate-features.mjs && node scripts/generate-game-skins.mjs && node scripts/build-editor-styles.mjs && node scripts/bundle.mjs && node scripts/build-worker.mjs && node scripts/validate-worker.mjs",
    "test:portal": "node --test tests/portal-foundation.test.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^26.0.0",
    "jsqr": "^1.4.0"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
